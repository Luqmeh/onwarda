#!/bin/sh
# Reject a push that introduces a commit whose author email is not the
# Onwarda repository identity. Existing remote history is not rechecked.

expected="93534158+Luqmeh@users.noreply.github.com"
zero="0000000000000000000000000000000000000000"
remote_name="$1"
fail=0

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ -z "$local_sha" ]; then
    continue
  fi

  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes="$remote_name" 2>/dev/null)
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi

  for commit in $commits
  do
    email=$(git log -1 --format='%ae' "$commit")
    if [ "$email" != "$expected" ]; then
      echo "pre-push: refusing to push $commit" >&2
      echo "pre-push: author email is '$email'" >&2
      echo "pre-push: expected '$expected'" >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo "pre-push: push rejected. Use the repository Git identity and create a new commit." >&2
  exit 1
fi

exit 0
